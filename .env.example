# Copy this file to ".env" in the project root (convertpro-studio/.env).
# Never commit the real .env file. It is listed in .gitignore.

APP_NAME=ConvertPro Studio
ENVIRONMENT=local
LOG_LEVEL=INFO

# Browser addresses allowed to call the backend (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits in megabytes. Enforced by the tools in later phases.
MAX_UPLOAD_MB=100
MAX_VIDEO_UPLOAD_MB=500

# How long temporary files may stay in storage/ before cleanup (used from Phase 6).
FILE_RETENTION_MINUTES=30
